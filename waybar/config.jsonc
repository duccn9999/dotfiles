{
  "layer": "top",
  "position": "top",
  "height": 36,

  "modules-left": ["niri/workspaces", "wlr/taskbar"],

  "modules-center": ["clock"],

  "modules-right": [
    "cpu",
    "network",
    "pulseaudio",
    "battery",
    "tray",
    "custom/start",
  ],

  "clock": {
    "format": "󰥔 {:%d/%m/%Y %H:%M}",
    "tooltip": false,
  },

  "cpu": {
    "format": "󰍛 {usage}%",
    "tooltip": false,
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",

    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],

    "tooltip": false,
  },

  "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰈀 ethernet",
    "format-disconnected": "󰖪 offline",

    "on-click": "nm-connection-editor",
    "tooltip": false,
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",

    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },

    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",

    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",

    "tooltip": false,
  },

  "tray": {
    "spacing": 10,
  },

  "niri/workspaces": {
    "format": "{index}",
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,

    "on-click": "activate",
    "on-click-middle": "close",

    "tooltip": false,
    "all-outputs": true,
  },

  "custom/start": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": false,
  },
}
